[user]
  # Force user.name/user.email to be set per-repo (via includeIf or `git config`).
  # Prevents accidental commits with a wrong identity.
  useConfigOnly = true

[init]
  defaultBranch = main

[core]
  excludesfile = ~/.gitignore_global

[merge]
  conflictstyle = zdiff3

[diff]
  algorithm = histogram
  colorMoved = default
  mnemonicPrefix = true
  renames = true

[pull]
  rebase = true

[push]
  default = simple
  autoSetupRemote = true
  followTags = true

[fetch]
  prune = true
  pruneTags = true

[rebase]
  autoStash = true
  autoSquash = true
  updateRefs = true

[rerere]
  enabled = true
  autoUpdate = true

[branch]
  sort = -committerdate

[column]
  ui = auto

[help]
  autocorrect = prompt

[alias]
  cleanup = !(git pull && git fetch --prune origin && git branch -vv | grep 'origin/.*: gone]' | awk '{print $1}' | xargs -r git branch -d)
  st = status -sb
  co = checkout
  br = branch
  last = log -1 HEAD --stat
  graph = log --oneline --graph --decorate --all
  unstage = reset HEAD --
  amend = commit --amend --no-edit
