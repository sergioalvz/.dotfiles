# --- Homebrew (must be early so subsequent tools resolve) --------------------
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# --- oh-my-zsh ---------------------------------------------------------------
export ZSH=$HOME/.oh-my-zsh

# Prompt is provided by starship (see end of file), so disable any oh-my-zsh theme.
ZSH_THEME=""

# --- Plugins -----------------------------------------------------------------
# `z` is replaced by `zoxide` (initialized below). nvm/rbenv are replaced by `mise`.
plugins=(git zsh-syntax-highlighting zsh-autosuggestions)

source $ZSH/oh-my-zsh.sh

# --- User configuration ------------------------------------------------------
export LANG=en_US.UTF-8
export EDITOR="code --wait"
export VISUAL="$EDITOR"

# --- Aliases -----------------------------------------------------------------
alias ls="eza"
alias ll="eza -la --git --icons"
alias lt="eza --tree --level=2 --icons"
alias cat="bat --paging=never"
alias g="git"

# --- Runtime manager (mise) --------------------------------------------------
# Replaces nvm + rbenv. Reads .nvmrc, .ruby-version, .python-version, .tool-versions.
if command -v mise &>/dev/null; then
  eval "$(mise activate zsh)"
fi

# --- Smarter cd (zoxide) -----------------------------------------------------
if command -v zoxide &>/dev/null; then
  eval "$(zoxide init zsh)"
fi

# --- Fuzzy finder (fzf) ------------------------------------------------------
# Loads keybindings (Ctrl-R history, Ctrl-T files, Alt-C cd) + completion.
if [[ -f "$(brew --prefix)/opt/fzf/shell/key-bindings.zsh" ]]; then
  source "$(brew --prefix)/opt/fzf/shell/key-bindings.zsh"
  source "$(brew --prefix)/opt/fzf/shell/completion.zsh"
fi

# --- 1Password SSH agent -----------------------------------------------------
export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# --- Local PATH --------------------------------------------------------------
export PATH="$HOME/bin:$PATH"

# --- Prompt (must be last) ---------------------------------------------------
if command -v starship &>/dev/null; then
  eval "$(starship init zsh)"
fi
